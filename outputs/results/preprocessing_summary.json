    "output_mode": "RGB",
    "output_size": "224x224",
    "tensor_shape": "3x224x224"
  },
  "split_ratios": {
    "train": "80%",
    "val": "10%",
    "test": "10%"
  },
  "random_seed": 42,
  "total_samples": 5000
}